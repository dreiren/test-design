<diagram id="runtime" name="1. Runtime architecture"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4360" pageHeight="2102" math="0" shadow="0" background="#F4F6F8"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;div style=&quot;font-family:Segoe UI;color:#FFFFFF;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Multi-tenant API platform on Azure&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;margin-top:4px&quot;&gt;Each API is its own spoke, with its own network and resources. Many tenant applications share the platform. Vendors are reached from one integration spoke.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#0B3D6E;strokeColor=#0B3D6E;verticalAlign=middle;align=left;spacingLeft=18;spacingRight=16;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="4288" height="76" as="geometry"/></mxCell>
