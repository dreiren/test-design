<mxCell id="4" value="&lt;div style=&quot;text-align:left;font-size:14px;line-height:1.35;color:#5C2D91;font-family:Segoe UI&quot;&gt;&lt;b&gt;Tenant applications  ·  many customers, one platform&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=14;fontColor=#5C2D91;fontStyle=1;spacingLeft=10;spacingRight=8;" vertex="1" parent="3"><mxGeometry x="8" y="4" width="3584" height="28" as="geometry"/></mxCell>
<mxCell id="5" value="&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.35;color:#605E5C;font-family:Segoe UI&quot;&gt;Each application signs in with Microsoft Entra ID and calls the same API host. The tenant id in the token selects the data. A new tenant is an app registration and a product, not a new network.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=11;fontColor=#605E5C;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="3"><mxGeometry x="8" y="32" width="3584" height="32" as="geometry"/></mxCell>
