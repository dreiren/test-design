<diagram id="flows" name="2. Flows and isolation"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4360" pageHeight="1410" math="0" shadow="0" background="#F4F6F8"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;div style=&quot;font-family:Segoe UI;color:#FFFFFF;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Flows and isolation model&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;margin-top:4px&quot;&gt;Read this with the runtime architecture. The pages use the same names: Customer, Orders, Catalog, and Integration.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#0B3D6E;strokeColor=#0B3D6E;verticalAlign=middle;align=left;spacingLeft=18;spacingRight=16;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="4288" height="72" as="geometry"/></mxCell>
<mxCell id="3" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#F4F6F8;strokeColor=#D0D5DD;strokeWidth=1.25;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="36" y="108" width="4288" height="300" as="geometry"/></mxCell>
<mxCell id="4" value="&lt;div style=&quot;text-align:left;font-size:15px;line-height:1.35;color:#0B3D6E;font-family:Segoe UI&quot;&gt;&lt;b&gt;Two boundaries that are easy to mix up&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#0B3D6E;fontStyle=1;spacingLeft=10;spacingRight=8;" vertex="1" parent="3"><mxGeometry x="8" y="4" width="4272" height="28" as="geometry"/></mxCell>
<mxCell id="5" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#F7F4FB;strokeColor=#5C2D91;strokeWidth=1.75;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="3"><mxGeometry x="12" y="42" width="2126" height="244" as="geometry"/></mxCell>
<mxCell id="6" value="&lt;div style=&quot;text-align:left;font-size:14px;line-height:1.35;color:#5C2D91;font-family:Segoe UI&quot;&gt;&lt;b&gt;Repeated for each tenant application&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=14;fontColor=#5C2D91;fontStyle=1;spacingLeft=10;spacingRight=8;" vertex="1" parent="5"><mxGeometry x="8" y="4" width="2110" height="28" as="geometry"/></mxCell>
<mxCell id="7" value="&lt;div style=&quot;text-align:left;font-size:13px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;An Entra ID app registration (enterprise application).&lt;br&gt;An API Management product and subscription: quota and rate limit.&lt;br&gt;Rows, or a partition, keyed by tenant id in every database the tenant uses.&lt;br&gt;A vendor account mapping, stored only in the integration database.&lt;br&gt;No virtual network, no resource group, and no database of its own.&lt;br&gt;A large tenant can later be pinned to a dedicated revision without a new landing zone.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="5"><mxGeometry x="12" y="40" width="2102" height="190" as="geometry"/></mxCell>
<mxCell id="8" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#E8F3FB;strokeColor=#0078D4;strokeWidth=1.75;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="3"><mxGeometry x="2150" y="42" width="2126" height="244" as="geometry"/></mxCell>
<mxCell id="9" value="&lt;div style=&quot;text-align:left;font-size:14px;line-height:1.35;color:#0078D4;font-family:Segoe UI&quot;&gt;&lt;b&gt;Repeated for each API microservice&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=14;fontColor=#0078D4;fontStyle=1;spacingLeft=10;spacingRight=8;" vertex="1" parent="8"><mxGeometry x="8" y="4" width="2110" height="28" as="geometry"/></mxCell>
<mxCell id="10" value="&lt;div style=&quot;text-align:left;font-size:13px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;Resource group rg-{api}-api.&lt;br&gt;Virtual network, NSG, and route table. Peering to the hub only.&lt;br&gt;Container Apps environment with internal ingress.&lt;br&gt;User-assigned managed identity id-{api}-api.&lt;br&gt;Key Vault, a private database, and private endpoints.&lt;br&gt;Application Insights appi-{api}-api, linked to the central workspace.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="8"><mxGeometry x="12" y="40" width="2102" height="190" as="geometry"/></mxCell>
<mxCell id="11" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#E8F3FB;strokeColor=#0078D4;strokeWidth=1.75;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="36" y="424" width="4288" height="210" as="geometry"/></mxCell>
<mxCell id="12" value="&lt;div style=&quot;text-align:left;font-size:14px;line-height:1.35;color:#0078D4;font-family:Segoe UI&quot;&gt;&lt;b&gt;Flow A   ·   a tenant reads or updates its own data&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=14;fontColor=#0078D4;fontStyle=1;spacingLeft=10;spacingRight=8;" vertex="1" parent="11"><mxGeometry x="8" y="4" width="4272" height="26" as="geometry"/></mxCell>
<mxCell id="13" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="11"><mxGeometry x="12" y="40" width="688" height="156" as="geometry"/></mxCell>
<mxCell id="14" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;1   Sign in&lt;/b&gt;&lt;br&gt;The app gets a token from Entra ID. Users sign in. The partner app uses client credentials.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="13"><mxGeometry x="8" y="6" width="672" height="144" as="geometry"/></mxCell>
<mxCell id="15" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="11"><mxGeometry x="728" y="40" width="688" height="156" as="geometry"/></mxCell>
<mxCell id="16" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;2   Call the host&lt;/b&gt;&lt;br&gt;The app calls the shared API host with the bearer token. It has no private network path.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="15"><mxGeometry x="8" y="6" width="672" height="144" as="geometry"/></mxCell>
<mxCell id="17" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="11"><mxGeometry x="1444" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="18" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;3   Enter Azure&lt;/b&gt;&lt;br&gt;Front Door terminates TLS and applies the WAF. The origin is API Management over Private Link.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="17"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="19" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="11"><mxGeometry x="2159" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="20" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;4   Enforce tenant&lt;/b&gt;&lt;br&gt;API Management checks issuer, audience, tenant id, and roles, then the tenant quota.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="19"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="21" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="11"><mxGeometry x="2874" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="22" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;5   Enter one spoke&lt;/b&gt;&lt;br&gt;The route reaches that API on its internal ingress. The spoke is not on the internet.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="21"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="23" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="11"><mxGeometry x="3589" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="24" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;6   Read its rows&lt;/b&gt;&lt;br&gt;The API uses its managed identity and a private endpoint. The database scopes by tenant id.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="23"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#0078D4;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#0078D4;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#0078D4;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="17" target="19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#0078D4;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="19" target="21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#0078D4;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="21" target="23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="30" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFF8F3;strokeColor=#CA5010;strokeWidth=1.75;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="36" y="648" width="4288" height="210" as="geometry"/></mxCell>
<mxCell id="31" value="&lt;div style=&quot;text-align:left;font-size:14px;line-height:1.35;color:#CA5010;font-family:Segoe UI&quot;&gt;&lt;b&gt;Flow B   ·   an order that must reach a vendor&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=14;fontColor=#CA5010;fontStyle=1;spacingLeft=10;spacingRight=8;" vertex="1" parent="30"><mxGeometry x="8" y="4" width="4272" height="26" as="geometry"/></mxCell>
<mxCell id="32" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="30"><mxGeometry x="12" y="40" width="688" height="156" as="geometry"/></mxCell>
<mxCell id="33" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;1   Accept&lt;/b&gt;&lt;br&gt;Orders API writes the order to its own SQL database. The token was already checked.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="32"><mxGeometry x="8" y="6" width="672" height="144" as="geometry"/></mxCell>
<mxCell id="34" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="30"><mxGeometry x="728" y="40" width="688" height="156" as="geometry"/></mxCell>
<mxCell id="35" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;2   Publish&lt;/b&gt;&lt;br&gt;It commits order.created to Service Bus. It does not call another API or a vendor.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="34"><mxGeometry x="8" y="6" width="672" height="144" as="geometry"/></mxCell>
<mxCell id="36" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="30"><mxGeometry x="1444" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="37" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;3   Hand off&lt;/b&gt;&lt;br&gt;Integration API consumes its own subscription. Retries happen here, not in the order transaction.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="36"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="38" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="30"><mxGeometry x="2159" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="39" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;4   Unlock secret&lt;/b&gt;&lt;br&gt;The adapter reads that vendor credential from kv-integration-api with its own identity.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="38"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="40" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="30"><mxGeometry x="2874" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="41" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;5   Leave Azure&lt;/b&gt;&lt;br&gt;Firewall allows the vendor FQDN and SNATs from the firewall public IP. Other spokes cannot.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="40"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="42" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="30"><mxGeometry x="3589" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="43" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;6   Record result&lt;/b&gt;&lt;br&gt;PostgreSQL stores the outbox and idempotency key. A status change becomes vendor.callback.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="42"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#CA5010;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="32" target="34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#CA5010;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="34" target="36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#CA5010;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="36" target="38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#CA5010;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="38" target="40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#CA5010;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="40" target="42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="49" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#F7F7F7;strokeColor=#605E5C;strokeWidth=1.75;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="36" y="872" width="4288" height="210" as="geometry"/></mxCell>
<mxCell id="50" value="&lt;div style=&quot;text-align:left;font-size:14px;line-height:1.35;color:#605E5C;font-family:Segoe UI&quot;&gt;&lt;b&gt;Flow C   ·   a vendor calls back&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=14;fontColor=#605E5C;fontStyle=1;spacingLeft=10;spacingRight=8;" vertex="1" parent="49"><mxGeometry x="8" y="4" width="4272" height="26" as="geometry"/></mxCell>
<mxCell id="51" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="49"><mxGeometry x="12" y="40" width="688" height="156" as="geometry"/></mxCell>
<mxCell id="52" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;1   Public host&lt;/b&gt;&lt;br&gt;The vendor calls the webhook URL. This is the only unsolicited inbound path.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="51"><mxGeometry x="8" y="6" width="672" height="144" as="geometry"/></mxCell>
<mxCell id="53" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="49"><mxGeometry x="728" y="40" width="688" height="156" as="geometry"/></mxCell>
<mxCell id="54" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;2   Filter&lt;/b&gt;&lt;br&gt;Front Door allow-lists the vendor. The WAF inspects the request.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="53"><mxGeometry x="8" y="6" width="672" height="144" as="geometry"/></mxCell>
<mxCell id="55" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="49"><mxGeometry x="1444" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="56" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;3   Prove sender&lt;/b&gt;&lt;br&gt;API Management checks the signature and drops unknown callbacks.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="55"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="57" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="49"><mxGeometry x="2159" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="58" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;4   One spoke&lt;/b&gt;&lt;br&gt;Only the integration API accepts it, and only after an inbox row is stored.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="57"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="59" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="49"><mxGeometry x="2874" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="60" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;5   Tell the owner&lt;/b&gt;&lt;br&gt;It publishes vendor.callback. Orders API updates status in its own database.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="59"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="61" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="49"><mxGeometry x="3589" y="40" width="687" height="156" as="geometry"/></mxCell>
<mxCell id="62" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;6   Close the loop&lt;/b&gt;&lt;br&gt;The tenant later reads status through Flow A. The vendor never sees that database.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="61"><mxGeometry x="8" y="6" width="671" height="144" as="geometry"/></mxCell>
<mxCell id="63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#605E5C;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="51" target="53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#605E5C;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="53" target="55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#605E5C;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="55" target="57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#605E5C;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="57" target="59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;jumpStyle=arc;jumpSize=7;strokeWidth=1.5;strokeColor=#605E5C;fontSize=11;fontColor=#323130;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="59" target="61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="68" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFEF8;strokeColor=#8A6116;strokeWidth=1.75;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="36" y="1096" width="4288" height="250" as="geometry"/></mxCell>
<mxCell id="69" value="&lt;div style=&quot;text-align:left;font-size:15px;line-height:1.35;color:#8A6116;font-family:Segoe UI&quot;&gt;&lt;b&gt;Rules that keep the design from collapsing&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=15;fontColor=#8A6116;fontStyle=1;spacingLeft=10;spacingRight=8;" vertex="1" parent="68"><mxGeometry x="8" y="4" width="4272" height="28" as="geometry"/></mxCell>
<mxCell id="70" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#E6D7A8;strokeWidth=1;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="68"><mxGeometry x="12" y="42" width="1057" height="90" as="geometry"/></mxCell>
<mxCell id="71" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;1  One spoke per API&lt;/b&gt;&lt;br&gt;A new API gets its own resource group, network, identity, vault, database, and Application Insights.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="70"><mxGeometry x="8" y="6" width="1041" height="78" as="geometry"/></mxCell>
<mxCell id="72" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#E6D7A8;strokeWidth=1;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="68"><mxGeometry x="12" y="140" width="1057" height="90" as="geometry"/></mxCell>
<mxCell id="73" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;5  No spoke-to-spoke calls&lt;/b&gt;&lt;br&gt;Cross-API work is a Service Bus message. A vendor outage stops at the integration spoke.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="72"><mxGeometry x="8" y="6" width="1041" height="78" as="geometry"/></mxCell>
<mxCell id="74" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#E6D7A8;strokeWidth=1;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="68"><mxGeometry x="1081" y="42" width="1057" height="90" as="geometry"/></mxCell>
<mxCell id="75" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;2  Many tenants per spoke&lt;/b&gt;&lt;br&gt;A new tenant gets a registration and an API product, not a virtual network.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="74"><mxGeometry x="8" y="6" width="1041" height="78" as="geometry"/></mxCell>
<mxCell id="76" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#E6D7A8;strokeWidth=1;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="68"><mxGeometry x="1081" y="140" width="1057" height="90" as="geometry"/></mxCell>
<mxCell id="77" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;6  Vendors are a privilege&lt;/b&gt;&lt;br&gt;Only the integration spoke may call out, and only to names on the firewall allow list.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="76"><mxGeometry x="8" y="6" width="1041" height="78" as="geometry"/></mxCell>
<mxCell id="78" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#E6D7A8;strokeWidth=1;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="68"><mxGeometry x="2150" y="42" width="1057" height="90" as="geometry"/></mxCell>
<mxCell id="79" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;3  Private data plane&lt;/b&gt;&lt;br&gt;Databases, Key Vault, Redis, Storage, and Service Bus accept private endpoints only.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="78"><mxGeometry x="8" y="6" width="1041" height="78" as="geometry"/></mxCell>
<mxCell id="80" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#E6D7A8;strokeWidth=1;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="68"><mxGeometry x="2150" y="140" width="1057" height="90" as="geometry"/></mxCell>
<mxCell id="81" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;7  One operations view&lt;/b&gt;&lt;br&gt;Spoke Application Insights resources link to one Log Analytics workspace and Azure Monitor.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="80"><mxGeometry x="8" y="6" width="1041" height="78" as="geometry"/></mxCell>
<mxCell id="82" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#E6D7A8;strokeWidth=1;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="68"><mxGeometry x="3219" y="42" width="1057" height="90" as="geometry"/></mxCell>
<mxCell id="83" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;4  Hub is the only door&lt;/b&gt;&lt;br&gt;Inbound traffic enters through Front Door. Spoke egress goes to Azure Firewall.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="82"><mxGeometry x="8" y="6" width="1041" height="78" as="geometry"/></mxCell>
<mxCell id="84" value="" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;collapsible=0;container=1;recursiveResize=0;verticalAlign=top;align=left;spacing=0;fillColor=#FFFFFF;strokeColor=#E6D7A8;strokeWidth=1;arcSize=10;absoluteArcSize=1;fontFamily=Segoe UI;" vertex="1" parent="68"><mxGeometry x="3219" y="140" width="1057" height="90" as="geometry"/></mxCell>
<mxCell id="85" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.35;color:#201F1E;font-family:Segoe UI&quot;&gt;&lt;b&gt;8  Zones, one region&lt;/b&gt;&lt;br&gt;Compute and data use availability zones. A second region is a later decision, not a second copy of this drawing.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#201F1E;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="84"><mxGeometry x="8" y="6" width="1041" height="78" as="geometry"/></mxCell>
<mxCell id="86" value="Companion page: Runtime architecture. Monitoring tools on that page are Azure Monitor, Log Analytics, Application Insights, alerts with an action group, and Workbooks." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#605E5C;fontStyle=0;spacingLeft=10;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="36" y="1362" width="4288" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram>
